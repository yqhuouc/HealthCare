@startuml UseCase_TongQuan
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}
skinparam packageStyle rectangle

' ============================
' ACTORS
' ============================
actor "Bệnh nhân" as BN #LightBlue
actor "Bác sĩ" as BS #LightGreen
actor "Quản trị viên" as AD #LightCoral

' Actor kế thừa (Generalization) - tất cả đều là Người dùng
actor "Người dùng" as ND #WhiteSmoke

BN --|> ND
BS --|> ND
AD --|> ND

' ============================
' SYSTEM BOUNDARY
' ============================
rectangle "Hệ thống Đặt lịch khám bệnh trực tuyến - ClinicBooking" {

  ' --- NHÓM XÁC THỰC ---
  package "Xác thực" #AliceBlue {
    usecase "UC01: Đăng ký\ntài khoản" as UC01
    usecase "UC02: Đăng nhập" as UC02
    usecase "UC03: Đăng xuất" as UC03
    usecase "UC04: Đổi mật khẩu" as UC04
    usecase "UC05: Cập nhật hồ sơ\ncá nhân" as UC05
    usecase "UC06: Làm mới\nAccess Token" as UC06
  }

  ' --- NHÓM BỆNH NHÂN ---
  package "Chức năng Bệnh nhân" #Honeydew {
    usecase "UC07: Xem danh sách\nchuyên khoa" as UC07
    usecase "UC08: Tìm kiếm bác sĩ\ntheo chuyên khoa" as UC08
    usecase "UC09: Xem thông tin\nchi tiết bác sĩ" as UC09
    usecase "UC10: Đặt lịch khám" as UC10 #PaleGreen
    usecase "UC11: Xem lịch sử\nlịch hẹn" as UC11
    usecase "UC12: Hủy lịch hẹn" as UC12
    usecase "UC13: Xem kết quả khám\nvà đơn thuốc" as UC13
    usecase "UC14: Xem câu hỏi\nthường gặp" as UC14
  }

  ' --- NHÓM BÁC SĨ ---
  package "Chức năng Bác sĩ" #LavenderBlush {
    usecase "UC15: Tạo lịch\nlàm việc" as UC15
    usecase "UC16: Xem lịch hẹn\ncủa tôi" as UC16
    usecase "UC17: Cập nhật trạng thái\nlịch hẹn" as UC17
    usecase "UC18: Kê đơn thuốc" as UC18
  }

  ' --- NHÓM ADMIN ---
  package "Chức năng Quản trị" #MistyRose {
    usecase "UC19: Quản lý\nchuyên khoa" as UC19
    usecase "UC20: Quản lý\nbác sĩ" as UC20
    usecase "UC21: Quản lý\nbệnh nhân" as UC21
    usecase "UC22: Quản lý\ncâu hỏi thường gặp" as UC22
    usecase "UC23: Quản lý hình thức\nthanh toán" as UC23
    usecase "UC24: Xem tất cả\nlịch hẹn" as UC24
    usecase "UC25: Xem thống kê\nvà báo cáo" as UC25
  }

  ' --- USE CASE PHỤ (include/extend) ---
  usecase "Xác thực JWT" as INC_AUTH #LightGray
  usecase "Kiểm tra lịch\nlàm việc bác sĩ" as INC_SCHEDULE #LightGray
  usecase "Kiểm tra\ntrùng lịch" as INC_CONFLICT #LightGray
  usecase "Kiểm tra quyền\nsở hữu" as INC_OWNER #LightGray
  usecase "Kiểm tra trạng thái\nlịch hẹn" as INC_STATUS #LightGray
  usecase "Chọn hình thức\nthanh toán" as EXT_PAY #LightGray
}

' ============================
' ASSOCIATIONS: Actor → Use Case
' ============================

' Người dùng (kế thừa → cả 3 đều có)
ND -- UC02
ND -- UC03

' Bệnh nhân
BN -- UC01
BN "1" -- "0..*" UC04
BN "1" -- "0..*" UC05
BN -- UC07
BN -- UC08
BN -- UC09
BN "1" -- "0..*" UC10 : đặt nhiều lần >
BN "1" -- "0..*" UC11
BN "1" -- "0..*" UC12
BN "1" -- "0..*" UC13
BN -- UC14

' Bác sĩ
BS "1" -- "0..*" UC04
BS "1" -- "0..*" UC05
BS "1" -- "0..*" UC15 : tạo nhiều ca >
BS "1" -- "0..*" UC16
BS "1" -- "0..*" UC17
BS "1" -- "0..*" UC18

' Admin
AD "1" -- "0..*" UC17
AD -- UC19
AD -- UC20
AD -- UC21
AD -- UC22
AD -- UC23
AD "1" -- "0..*" UC24
AD -- UC25

' ============================
' INCLUDE RELATIONSHIPS
' ============================
UC10 ..> INC_AUTH : <<include>>
UC10 ..> INC_SCHEDULE : <<include>>
UC10 ..> INC_CONFLICT : <<include>>

UC12 ..> INC_AUTH : <<include>>
UC12 ..> INC_OWNER : <<include>>
UC12 ..> INC_STATUS : <<include>>

UC17 ..> INC_AUTH : <<include>>
UC17 ..> INC_OWNER : <<include>>

UC18 ..> INC_AUTH : <<include>>
UC18 ..> INC_STATUS : <<include>>

UC15 ..> INC_AUTH : <<include>>

UC06 ..> UC02 : <<include>>

' ============================
' EXTEND RELATIONSHIPS
' ============================
EXT_PAY ..> UC10 : <<extend>>

' ============================
' GHI CHÚ
' ============================
note right of INC_CONFLICT
  UNIQUE constraint:
  bacSiId + ngayDat + gioBatDau
  → Chống trùng lịch
end note

note right of INC_AUTH
  Middleware authenticate
  verify JWT token
end note

note bottom of UC06
  Refresh Token Rotation:
  Tạo cặp token mới,
  token cũ vô hiệu
end note

note right of EXT_PAY
  Extension point:
  Bệnh nhân chọn
  hình thức thanh toán
  khi đặt lịch
end note
@enduml
