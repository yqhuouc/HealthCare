@startuml Activity_DangNhap_V3

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Người dùng|
start
:Nhập Email và Mật khẩu;
:Bấm nút Đăng nhập;

|Hệ thống|
:Validate dữ liệu đầu vào (loginSchema);
if (Dữ liệu hợp lệ?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Tìm tài khoản theo Email;
  if (Tài khoản tồn tại?) then (Không)
    :Trả về mã 401 (Unauthorized);
    stop
  else (Có)
    if (Tài khoản bị khóa?) then (Có)
      :Trả về mã 403 (Forbidden);
      stop
    else (Không)
      :So sánh mật khẩu (bcrypt.compare);
      if (Mật khẩu chính xác?) then (Không)
        :Trả về mã 401 (Unauthorized);
        stop
      else (Có)
        :Tạo AccessToken & RefreshToken (JWT);
        :Lưu RefreshToken vào Database;
        :Thiết lập Cookie HttpOnly;
        :Trả về thông tin User;
      endif
    endif
  endif
endif

|Người dùng|
:Nhận kết quả đăng nhập;
if (Vai trò của User?) then (Admin)
  :Điều hướng trang Quản trị;
elseif (Bác sĩ)
  :Điều hướng trang Bác sĩ;
else (Bệnh nhân)
  :Điều hướng trang Bệnh nhân;
endif

stop
@enduml