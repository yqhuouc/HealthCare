@startuml Activity_DangNhap

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  RoundCorner 15
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Nguoi dung / Frontend|
start
:Nhap email va mat khau;
:Bam nut Dang nhap;

|May chu / Backend|
:Validate du lieu dau vao;

if (Du lieu hop le?) then (Khong)
  :Tra loi 400;
  stop
endif

:Tim tai khoan theo email;

if (Ton tai tai khoan?) then (Khong)
  :Tra loi 401;
  stop
endif

if (Tai khoan bi khoa?) then (Co)
  :Tra loi 403;
  stop
endif

:So sanh mat khau bcrypt;

if (Mat khau dung?) then (Khong)
  :Tra loi 401;
  stop
endif

:Tao AccessToken + RefreshToken;
:Luu refreshToken vao DB;
:Set cookie HttpOnly:\naccessToken(path=/)\nrefreshToken(path=/api/auth);
:Tra thong tin user;

|Nguoi dung / Frontend|
:Nhan ket qua dang nhap;

if (Vai tro?) then (Admin)
  :Chuyen trang Admin;
elseif (Bac si)
  :Chuyen trang Bac si;
else (Benh nhan)
  :Chuyen trang Benh nhan;
endif

stop
@enduml