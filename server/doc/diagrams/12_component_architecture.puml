@startuml Component_Architecture
skinparam component {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

package "Trình duyệt Web" <<Node>> #LightBlue {
  package "Frontend (React 19 + Vite 7)" {
    [Các trang\n(Admin / Bác sĩ / Bệnh nhân)] as Pages
    [Components\n(Layout, UI)] as Comps
    [Dịch vụ API\n(Axios)] as ApiSvc
    [Zustand Store\n(Quản lý trạng thái)] as Store
    [React Router DOM\n(Định tuyến)] as Router
  }
}

package "Máy chủ Node.js" <<Node>> #LightGreen {
  package "Backend (Express 4)" {
    [Routes\n(9 module)] as Routes
    [Middlewares\n(Auth, Validate, Error)] as MW
    [Controllers\n(9 controller)] as Ctrl
    [Services\n(9 module nghiệp vụ)] as Svc
    [Prisma Client\n(ORM)] as Prisma
  }
}

database "Supabase Cloud" <<Node>> #LightCoral {
  [PostgreSQL\n(10 bảng)] as DB
}

Pages --> ApiSvc
ApiSvc --> Routes : HTTP/REST\n+ JWT

Routes --> MW
MW --> Ctrl
Ctrl --> Svc
Svc --> Prisma
Prisma --> DB : PostgreSQL\nConnection\n(pgbouncer)
@enduml
