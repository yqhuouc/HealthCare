@startuml Seq_CapNhatThongTinCaNhan
skinparam sequenceArrowThickness 2
actor "Người dùng" as User
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "Auth\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

User -> FE : Sửa thông tin cá nhân\n(tên, SĐT, địa chỉ,\ngiới tính, ảnh đại diện)
activate FE
FE -> RT : PUT /api/auth/cap-nhat-ho-so\n(Bearer token + body)
activate RT
RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH --> RT : req.user
deactivate AUTH
RT -> SV : capNhatHoSo(userId, data)
activate SV

SV -> DB : findUnique({id})\n+ include bacSi/benhNhan
activate DB
DB --> SV : Thông tin hiện tại
deactivate DB

alt Tài khoản tồn tại
  SV -> DB : UPDATE TaiKhoan\nSET gioiTinh, ngaySinh,\ndiaChi, anhDaiDien...
  activate DB
  DB --> SV : Đã cập nhật
  deactivate DB
  
  SV -> SV : Kiểm tra vai trò

  alt Bệnh nhân
    SV -> DB : UPDATE BenhNhan\nSET hoTen, soDienThoai...
    activate DB
    DB --> SV : OK
    deactivate DB
  else Bác sĩ
    SV -> DB : UPDATE BacSi\nSET tenBacSi, moTaNgan...
    activate DB
    DB --> SV : OK
    deactivate DB
  end

  SV --> RT : Dữ liệu mới\n(ẩn matKhau)
  deactivate SV
  RT --> FE : 200 OK
  deactivate RT
  FE --> User : Hiển thị\ncập nhật thành công
else Không tìm thấy
  SV --> RT : Lỗi 404
  RT --> FE : 404
  FE --> User : Hiển thị lỗi
end
deactivate FE
@enduml
