@startuml Activity_VNPay_Callback

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  RoundCorner 15
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|VNPay Gateway|
start
:Gui ket qua thanh toan qua IPN/Return URL;

|May chu / Backend|
:Nhan callback tu VNPay;
:Xac thuc chu ky checksum;

if (Chu ky hop le?) then (Khong)
  :Tra loi Invalid Signature;
  stop
endif

:Tim GiaoDich theo ma tham chieu;
if (Giao dich ton tai?) then (Khong)
  :Tra loi Order not found;
  stop
endif

:Kiem tra ma ket qua VNPay;
if (Thanh cong code=00?) then (Co)
  :Cap nhat GiaoDich thanh cong;
  :Cap nhat DatLich thanh toan=1,\ntrangThai=Da xac nhan;
  :Gui thong bao/xac nhan cho benh nhan;
else (Khong)
  :Cap nhat GiaoDich that bai;
  :Giu nguyen DatLich;
endif

:Tra ket qua xac nhan da nhan IPN cho VNPay;
stop
@enduml
