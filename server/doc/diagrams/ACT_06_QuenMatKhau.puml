@startuml Activity_QuenMatKhau_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Người dùng|
start
:Nhấn "Quên mật khẩu";
:Nhập Email tài khoản;
:Gửi yêu cầu khôi phục;

|Hệ thống|
:Kiểm tra Email trong hệ thống;
if (Email tồn tại?) then (Không)
  :Trả về mã 404 (Not Found);
  stop
else (Có)
  :Tạo Token Reset mật khẩu\n(Thời hạn 15-30 phút);
  :Gửi Email chứa Link/OTP;
endif

|Người dùng|
:Mở link từ Email;
:Nhập mật khẩu mới & Xác nhận;
:Gửi yêu cầu cập nhật;

|Hệ thống|
:Kiểm tra Token hợp lệ & Còn hạn?;
if (Hợp lệ?) then (Không)
  :Thông báo Token hết hạn/Không hợp lệ;
  stop
else (Có)
  :Mã hóa mật khẩu mới (bcrypt);
  :Cập nhật Database;
  :Hủy bỏ Token đã sử dụng;
  :Trả về thông báo thành công;
endif

|Người dùng|
:Hiển thị thông báo thành công;
:Điều hướng về trang Đăng nhập;
stop
@enduml