@startuml SYS_SEQ_09_Duyet_LichLamViec
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_09_Duyet_LichLamViec

actor "Quản trị viên" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Yêu cầu duyệt lịch làm việc
activate Sys

Sys -> DB : 1.1: Cập nhật trạng thái duyệt
activate DB
DB --> Sys : 1.2: Trả về trạng thái
deactivate DB

alt Thành công
    Sys --> User : 1.3: Thông báo trạng thái thành công
else Lỗi cập nhật
    Sys --> User : 1.4: Hiển thị thông báo lỗi
end

deactivate Sys

@enduml
