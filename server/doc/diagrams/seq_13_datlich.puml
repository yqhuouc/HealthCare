@startuml Seq_DatLichKham
skinparam sequenceArrowThickness 2
actor "Bệnh nhân" as BN
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "DatLich\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

BN -> FE : Chọn bác sĩ, ngày,\nkhung giờ, lý do khám,\nhình thức thanh toán
activate FE
FE -> RT : POST /api/dat-lich\n(Bearer token + body)
activate RT
RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH --> RT : req.user
deactivate AUTH
RT -> SV : create(data)
activate SV

SV -> DB : Kiểm tra BácSĩ tồn tại
activate DB
DB --> SV : BácSĩ
deactivate DB

SV -> DB : Kiểm tra BệnhNhân tồn tại
activate DB
DB --> SV : BệnhNhân
deactivate DB

SV -> DB : Kiểm tra LịchLàmViệc\n(bacSiId + ngày + sẵn sàng=1)
activate DB
DB --> SV : Lịch làm việc
deactivate DB

SV -> DB : Kiểm tra trùng\n(UNIQUE: bacSiId+ngày+giờ)
activate DB
DB --> SV : Kết quả
deactivate DB

alt Không trùng + Có lịch
  SV -> DB : INSERT DatLich\n(trangThai=0: Chờ xác nhận)
  activate DB
  DB --> SV : Lịch hẹn đã tạo
  deactivate DB
  SV --> RT : Dữ liệu lịch hẹn
  RT --> FE : 201 Created
  FE --> BN : Hiển thị\nĐặt lịch thành công
else Trùng lịch
  SV --> RT : Lỗi 409 Conflict
  RT --> FE : 409 Lịch đã đặt
  FE --> BN : Hiển thị lỗi trùng
else Không có lịch làm việc
  SV --> RT : Lỗi 400
  RT --> FE : 400 Bác sĩ\nkhông có lịch
  FE --> BN : Hiển thị lỗi
end
deactivate SV
deactivate RT
deactivate FE
@enduml
