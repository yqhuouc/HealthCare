@startuml State_LichHen
skinparam state {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

[*] --> ChoXacNhan : Bệnh nhân\nđặt lịch khám

state "Chờ xác nhận" as ChoXacNhan #PaleGreen {
  ChoXacNhan : trangThai = 0
  ChoXacNhan : ---
  ChoXacNhan : Lịch hẹn mới tạo
  ChoXacNhan : Chờ bác sĩ xác nhận
}

state "Đã xác nhận" as DaXacNhan #LightBlue {
  DaXacNhan : trangThai = 1
  DaXacNhan : ---
  DaXacNhan : Bác sĩ đã tiếp nhận
  DaXacNhan : Chờ ngày khám
}

state "Đã khám" as DaKham #Plum {
  DaKham : trangThai = 2
  DaKham : ---
  DaKham : Hoàn thành khám bệnh
  DaKham : Có thể kê đơn thuốc
}

state "Đã hủy" as DaHuy #Salmon {
  DaHuy : trangThai = 3
  DaHuy : ---
  DaHuy : Lịch hẹn đã bị hủy
  DaHuy : Không thể thay đổi
}

ChoXacNhan --> DaXacNhan : Bác sĩ / Admin\nxác nhận
ChoXacNhan --> DaHuy : Bệnh nhân /\nBác sĩ / Admin hủy

DaXacNhan --> DaKham : Bác sĩ hoàn thành\nkhám bệnh
DaXacNhan --> DaHuy : Bác sĩ /\nAdmin hủy

DaKham --> [*]
DaHuy --> [*]
@enduml
