@startuml Seq_CapNhatThongTinBacSi
skinparam sequenceArrowThickness 2
actor "Admin" as AD
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "BacSi\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

AD -> FE : Sửa thông tin bác sĩ\n(tên, giá, chuyên khoa...)
activate FE
FE -> RT : PUT /api/bac-si/:id\n(Bearer token + body)
activate RT
RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH --> RT : req.user (Admin)
deactivate AUTH
RT -> SV : update(id, data)
activate SV
SV -> DB : findUnique({id})
activate DB
DB --> SV : Bác sĩ hiện tại
deactivate DB

alt Bác sĩ tồn tại
  SV -> DB : UPDATE BacSi\nSET tenBacSi, giaKham...
  activate DB
  DB --> SV : Bác sĩ đã cập nhật
  deactivate DB
  SV --> RT : Dữ liệu bác sĩ mới
  deactivate SV
  RT --> FE : 200 OK
  FE --> AD : Hiển thị thành công
else Không tìm thấy
  SV --> RT : Lỗi 404
  RT --> FE : 404 Không tìm thấy
  FE --> AD : Hiển thị lỗi
end
deactivate RT
deactivate FE
@enduml
