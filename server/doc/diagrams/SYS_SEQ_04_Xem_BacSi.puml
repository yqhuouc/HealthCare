@startuml SYS_SEQ_04_Xem_BacSi
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_04_Xem_BacSi

actor "Quản trị viên / Bệnh nhân" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Yêu cầu xem danh sách bác sĩ
activate Sys

Sys -> DB : 1.1: Truy vấn danh sách bác sĩ
activate DB
DB --> Sys : 1.2: Trả về danh sách
deactivate DB

alt Thành công
    Sys --> User : 1.3: Hiển thị danh sách bác sĩ
else Lỗi hệ thống
    Sys --> User : 1.4: Hiển thị thông báo lỗi
end

deactivate Sys

@enduml
