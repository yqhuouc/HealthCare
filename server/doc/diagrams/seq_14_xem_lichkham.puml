@startuml Seq_XemLichKham
skinparam sequenceArrowThickness 2
actor "Bệnh nhân" as BN
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "DatLich\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

BN -> FE : Xem chi tiết\nmột lịch hẹn
activate FE
FE -> RT : GET /api/dat-lich/:id\n(Bearer token)
activate RT
RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH --> RT : req.user
deactivate AUTH
RT -> SV : getById(id)
activate SV
SV -> DB : findUnique({id})\n+ include bacSi,\nbenhNhan,\nhinhThucThanhToan,\ndonThuoc
activate DB
DB --> SV : Lịch hẹn chi tiết
deactivate DB

alt Tồn tại + Đúng quyền
  SV --> RT : Dữ liệu lịch hẹn
  deactivate SV
  RT --> FE : 200 OK
  deactivate RT
  FE --> BN : Hiển thị chi tiết\nlịch hẹn + đơn thuốc\n(nếu có)
else Không tìm thấy
  SV --> RT : Lỗi 404
  RT --> FE : 404
  FE --> BN : Hiển thị lỗi
end
deactivate FE
@enduml
