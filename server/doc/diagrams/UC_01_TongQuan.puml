@startuml UseCase_TongQuan
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ranksep 60
skinparam nodesep 30

skinparam usecase {
  BackgroundColor LightSkyBlue
  BorderColor #2C3E50
  FontSize 13
}

' ============================
' ACTORS
' ============================
actor "Bệnh nhân" as BN #SkyBlue
actor "Bác sĩ" as BS #LightGreen
actor "Quản trị viên" as AD #LightCoral

' ============================
' KHỐI DÙNG CHUNG - TÀI KHOẢN
' ============================
rectangle "Quản lý Tài khoản" as P_TK {
  usecase "Đăng nhập" as TK1
  usecase "Đăng ký tài khoản" as TK2
  usecase "Quên mật khẩu" as TK3
  usecase "Đổi mật khẩu" as TK4
  usecase "Cập nhật hồ sơ cá nhân" as TK5
}

' ============================
' PHÂN HỆ BỆNH NHÂN
' ============================
rectangle "Phân hệ Bệnh nhân" as P_BN {
  usecase "Tìm bác sĩ & Chuyên khoa" as BN1
  usecase "Đặt lịch khám" as BN2
  usecase "Thanh toán trực tuyến (VNPay)" as BN3
  usecase "Hủy lịch hẹn" as BN4
  usecase "Xem lịch sử & Kết quả khám" as BN5
  usecase "Xem đơn thuốc điện tử" as BN6
  usecase "Xem câu hỏi thường gặp" as BN7
}

' ============================
' PHÂN HỆ BÁC SĨ
' ============================
rectangle "Phân hệ Bác sĩ" as P_BS {
  usecase "Đăng ký lịch làm việc" as BS1
  usecase "Xem danh sách lịch hẹn" as BS2
  usecase "Xác nhận / Hủy lịch hẹn" as BS3
  usecase "Khám bệnh & Kê đơn thuốc" as BS4
}

' ============================
' PHÂN HỆ QUẢN TRỊ
' ============================
rectangle "Phân hệ Quản trị" as P_AD {
  usecase "Quản lý Bác sĩ" as AD1
  usecase "Quản lý Bệnh nhân" as AD2
  usecase "Quản lý Chuyên khoa" as AD3
  usecase "Quản lý Khung giờ khám" as AD4
  usecase "Quản lý Lịch hẹn" as AD5
  usecase "Quản lý Giao dịch & Thanh toán" as AD6
  usecase "Quản lý Câu hỏi thường gặp" as AD7
  usecase "Xem báo cáo & Thống kê" as AD8
}

' ============================
' KẾT NỐI CHUNG (TÀI KHOẢN)
' ============================
BN -- TK1
BN -- TK2
BN -- TK3
BN -- TK4
BN -- TK5

BS -- TK1
BS -- TK4
BS -- TK5

AD -- TK1
AD -- TK4
AD -- TK5

' ============================
' KẾT NỐI BỆNH NHÂN
' ============================
BN -- BN1
BN -- BN2
BN -- BN3
BN -- BN4
BN -- BN5
BN -- BN6
BN -- BN7

' ============================
' KẾT NỐI BÁC SĨ
' ============================
BS -- BS1
BS -- BS2
BS -- BS3
BS -- BS4

' ============================
' KẾT NỐI QUẢN TRỊ
' ============================
AD -- AD1
AD -- AD2
AD -- AD3
AD -- AD4
AD -- AD5
AD -- AD6
AD -- AD7
AD -- AD8

' ============================
' ÉP BỐ CỤC
' ============================
P_BN -[hidden]right- P_TK
P_TK -[hidden]right- P_BS
P_BS -[hidden]down- P_AD

@enduml