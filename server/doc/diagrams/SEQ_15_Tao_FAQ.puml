@startuml Seq_TaoFAQ
skinparam sequenceArrowThickness 2
actor "Admin" as AD
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "FAQ\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

AD -> FE : Nhập câu hỏi\nvà câu trả lời
activate FE
FE -> RT : POST /api/cau-hoi-thuong-gap\n(Bearer token + body)
activate RT
RT -> AUTH : authenticate(JWT)\n+ authorize("admin")
activate AUTH
AUTH --> RT : req.user (Admin)
deactivate AUTH
RT -> SV : create(data)
activate SV
SV -> DB : INSERT CauHoiThuongGap\n(dangHoatDong = 1)
activate DB
DB --> SV : FAQ đã tạo
deactivate DB
SV --> RT : Dữ liệu FAQ
deactivate SV
RT --> FE : 201 Created
deactivate RT
FE --> AD : Hiển thị thành công
deactivate FE
@enduml
