@startuml SYS_SEQ_10_Xem_LichKham_BN
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_10_Xem_LichKham_BN

actor "Bệnh nhân" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Xem danh sách lịch hẹn/khám
activate Sys

Sys -> DB : 1.1: Truy vấn lịch khám theo bệnh nhân ID
activate DB
DB --> Sys : 1.2: Trả về danh sách lịch
deactivate DB

alt Lấy dữ liệu ok
    Sys --> User : 1.3: Hiển thị danh sách lịch hẹn
else Lỗi
    Sys --> User : 1.4: Hiển thị thông báo lỗi
end

deactivate Sys

@enduml
