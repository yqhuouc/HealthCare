@startuml Activity_DangKyTaiKhoan

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Người dùng|
start
:Nhập họ tên, email, mật khẩu,\nsố điện thoại & thông tin cơ bản;
:Bấm nút Đăng ký;

|Hệ thống|
:Validate dữ liệu (registerSchema);
if (Dữ liệu hợp lệ?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Kiểm tra Email đã tồn tại?;
  if (Email đã tồn tại?) then (Có)
    :Trả về mã 409 (Conflict);
    stop
  else (Không)
    :Hash mật khẩu (bcrypt);
    :Tạo TaiKhoan & BenhNhan\n(Database Transaction);
    :Trả về mã 201 Created;
  endif
endif

|Người dùng|
:Hiển thị thông báo thành công;
:Điều hướng sang trang Đăng nhập;
stop
@enduml