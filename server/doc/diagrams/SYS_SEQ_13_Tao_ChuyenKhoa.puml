@startuml SYS_SEQ_13_Tao_ChuyenKhoa
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_13_Tao_ChuyenKhoa

actor "Quản trị viên" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Yêu cầu tạo chuyên khoa mới
activate Sys

Sys -> DB : 1.1: Thêm bản ghi vào bảng ChuyenKhoa
activate DB
DB --> Sys : 1.2: Trả về trạng thái thêm
deactivate DB

alt Thông tin hợp lệ
    Sys --> User : 1.3: Hiển thị thông báo thành công
else Trùng tên
    Sys --> User : 1.4: Thông báo lỗi đã tồn tại
end

deactivate Sys

@enduml
