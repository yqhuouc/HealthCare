@startuml Sequence_DangNhap
skinparam sequenceArrowThickness 2
skinparam sequenceParticipant underline

actor "Người dùng" as User
participant "Giao diện\n(React)" as FE #LightBlue
participant "Bộ định tuyến\n(Express Router)" as RT #LightYellow
participant "Dịch vụ\nxác thực" as SV #LightGreen
database "Cơ sở dữ liệu\n(PostgreSQL)" as DB #LightCoral

User -> FE : Nhập email + mật khẩu
activate FE
FE -> RT : POST /api/auth/login\n{email, matKhau}
activate RT

RT -> SV : login({email, matKhau})
activate SV
SV -> DB : findUnique({email})\n+ include bacSi, benhNhan
activate DB
DB --> SV : Dữ liệu TàiKhoản
deactivate DB

SV -> SV : bcrypt.compare\n(matKhau, hash)

alt Mật khẩu đúng
  SV -> SV : generateTokens(taiKhoanId)
  note right : Tạo Access Token\n(hết hạn ngắn)\n+ Refresh Token\n(hết hạn 7 ngày)

  SV -> DB : UPDATE TaiKhoan\nSET refreshToken = ?
  activate DB
  DB --> SV : OK
  deactivate DB

  SV --> RT : {user, accessToken, refreshToken}
  deactivate SV

  RT -> RT : res.cookie("refreshToken",\n{httpOnly, secure, sameSite})

  RT --> FE : 200 OK\n{user, accessToken}
  deactivate RT

  FE -> FE : Lưu accessToken\nvào Zustand store
  FE --> User : Chuyển hướng\ntheo vai trò

else Sai mật khẩu / Email không tồn tại
  SV --> RT : throw Error 401
  deactivate SV
  RT --> FE : 401 Sai email\nhoặc mật khẩu
  deactivate RT
  FE --> User : Hiển thị\nthông báo lỗi

else Tài khoản bị khóa
  SV --> RT : throw Error 403
  RT --> FE : 403 Tài khoản\nđã bị khóa
  FE --> User : Hiển thị\nthông báo lỗi
end

deactivate FE
@enduml
