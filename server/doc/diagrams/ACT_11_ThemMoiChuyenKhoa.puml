@startuml Activity_ThemMoiChuyenKhoa_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Quản trị viên (Admin)|
start
:Mở màn hình Quản lý chuyên khoa;
:Nhập Tên, Mô tả, Thời lượng khám & Icon;
:Bấm nút "Thêm mới";

|Hệ thống|
:Xác thực JWT & Kiểm tra quyền Admin;
:Validate dữ liệu (chuyenKhoaSchema);

if (Dữ liệu hợp lệ?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Kiểm tra tên chuyên khoa đã tồn tại?;
  if (Đã tồn tại?) then (Có)
    :Trả về mã 409 (Conflict);
    stop
  else (Không)
    :Tạo bản ghi Chuyên Khoa mới;
    :Lưu thông tin vào Database;
    :Trả về mã 201 (Created);
  endif
endif

|Quản trị viên (Admin)|
:Cập nhật danh sách hiển thị;
:Thông báo: "Thêm chuyên khoa thành công";
stop
@enduml