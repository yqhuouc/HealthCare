@startuml UC_QuanLyBenhNhan
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

actor "Quản trị viên" as AD #LightCoral
actor "Bệnh nhân" as BN #LightBlue

rectangle "Chức năng quản lý bệnh nhân" {
  usecase "Xem danh sách\nbệnh nhân" as UC1
  usecase "Xem thông tin\nchi tiết bệnh nhân" as UC2
  usecase "Xóa tài khoản\nbệnh nhân" as UC3
  usecase "Đăng ký\ntài khoản" as UC4
  usecase "Cập nhật\nhồ sơ cá nhân" as UC5

  usecase "Xác thực JWT" as INC1 #LightGray
  usecase "Kiểm tra quyền\nAdmin" as INC2 #LightGray
}

AD "1" -- "0..*" UC1
AD "1" -- "0..*" UC2
AD "1" -- "0..*" UC3
BN -- UC4
BN "1" -- "1" UC5

UC3 ..> INC1 : <<include>>
UC3 ..> INC2 : <<include>>
UC5 ..> INC1 : <<include>>
@enduml
