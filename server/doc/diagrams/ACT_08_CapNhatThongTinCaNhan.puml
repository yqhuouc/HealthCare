@startuml Activity_CapNhatThongTinCaNhan_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Người dùng|
start
:Mở trang Hồ sơ cá nhân;
:Nhập thông tin cần thay đổi\n(Họ tên, ngày sinh, địa chỉ...);
:Bấm nút "Lưu thay đổi";

|Hệ thống|
:Xác thực JWT (Authentication);
:Validate dữ liệu (userUpdateSchema);

if (Dữ liệu hợp lệ?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Tìm kiếm tài khoản theo UserID;
  :Cập nhật Database\n(Thông tin tài khoản & hồ sơ);
  :Trả kết quả cập nhật thành công;
endif

|Người dùng|
:Hiển thị thông báo thành công;
:Cập nhật thông tin trên giao diện;
stop
@enduml