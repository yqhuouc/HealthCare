@startuml Activity_XemThongKe_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Quản trị viên (Admin)|
start
:Mở trang Dashboard thống kê;
:Chọn loại báo cáo & Khoảng thời gian\n(Tổng quan, Lịch hẹn, Doanh thu);
:Gửi yêu cầu lấy số liệu;

|Hệ thống|
:Xác thực JWT & Kiểm tra quyền Admin;

if (Có quyền Admin?) then (Không)
  :Trả về mã 403 (Forbidden);
  stop
else (Có)
  if (Loại thống kê?) then (Tổng quan)
    :Thực thi thongKeService.tongQuan();
  elseif (Lịch hẹn) then (Lịch hẹn)
    :Thực thi thongKeService.thongKeLichHen();
  else (Doanh thu)
    :Thực thi thongKeService.thongKeDoanhThu();
  endif
  
  :Tổng hợp số liệu & Định dạng JSON;
  :Trả về dữ liệu thống kê;
endif

|Quản trị viên (Admin)|
:Xử lý dữ liệu & Vẽ biểu đồ\n(Bar Chart, Pie Chart, Statistics Card);
:Hiển thị Dashboard hoàn thiện;
stop
@enduml