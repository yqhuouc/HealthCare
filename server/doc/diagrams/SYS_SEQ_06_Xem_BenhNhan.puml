@startuml SYS_SEQ_06_Xem_BenhNhan
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_06_Xem_BenhNhan

actor "Quản trị viên" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Yêu cầu xem danh sách bệnh nhân
activate Sys

Sys -> DB : 1.1: Truy vấn danh sách bệnh nhân
activate DB
DB --> Sys : 1.2: Trả về dữ liệu người dùng
deactivate DB

alt Thành công
    Sys --> User : 1.3: Hiển thị danh sách bệnh nhân
else Lỗi hệ thống
    Sys --> User : 1.4: Hiển thị thông báo lỗi
end

deactivate Sys

@enduml
