@startuml Activity_KeDonThuoc_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bác sĩ|
start
:Chọn bệnh nhân từ danh sách chờ khám;
:Tiến hành khám lâm sàng & Chẩn đoán;
:Nhập kết quả chẩn đoán & Ghi chú;

repeat
  :Chọn thuốc từ danh mục;
  :Nhập số lượng, liều dùng & cách dùng;
  :Thêm vào danh sách đơn thuốc;
backward:Cần thêm thuốc khác;
repeat while (Tiếp tục thêm thuốc?) is (Có) not (Không)

:Xác nhận hoàn tất đơn thuốc;

|Hệ thống|
:Xác thực quyền hạn Bác sĩ (JWT);
:Tính toán tổng tiền đơn thuốc;
:Lưu DonThuoc & ChiTietDonThuoc\n(Database Transaction);
:Cập nhật trạng thái Lịch hẹn = "Đã khám";
:Trả kết quả lưu đơn thuốc;

|Bác sĩ|
:Hiển thị đơn thuốc hoàn tất;
:In đơn thuốc (nếu cần) & Thông báo bệnh nhân;
stop
@enduml