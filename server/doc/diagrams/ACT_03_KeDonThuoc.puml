@startuml Activity_KeDonThuoc

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  RoundCorner 15
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bac si|
start
:Dang nhap vao he thong;
:Xem danh sach lich hen da xac nhan;
:Chon mot benh nhan den kham;
:Tien hanh kham lam sang;
:Cap nhat trang thai lich hen thanh Da kham;

|May chu / Backend|
:Luu trang thai moi;
:Mo form ke don cho bac si;

|Bac si|
:Nhap chan doan va ghi chu;
repeat
  :Chon thuoc tu danh sach;
  :Nhap so luong, don gia, lieu dung;
  :Them vao danh muc don thuoc;
backward:Can them thuoc khac;
repeat while (Can them thuoc?) is (Co) not (Khong)
:Gui don thuoc hoan tat;

|May chu / Backend|
:Tinh toan tong tien;
:Luu DonThuoc va ChiTietDonThuoc;
:Tra ve ket qua thanh cong;

|Bac si|
:Thong bao cho benh nhan;
stop
@enduml
