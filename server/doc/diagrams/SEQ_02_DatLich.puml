@startuml Sequence_DatLich
skinparam sequenceArrowThickness 2

actor "Bệnh nhân" as BN
participant "Giao diện\n(React)" as FE #LightBlue
participant "Bộ định tuyến\n(Router)" as RT #LightYellow
participant "Middleware\nxác thực" as AUTH #Orange
participant "Dịch vụ\nĐặt lịch" as SV #LightGreen
participant "Dịch vụ\nVNPay" as PAY #PaleGreen
database "CSDL\n(PostgreSQL)" as DB #LightCoral

BN -> FE : Chọn bác sĩ, ngày,\nkhung giờ, lý do khám,\nhình thức thanh toán
activate FE
FE -> RT : POST /api/dat-lich\n(Bearer accessToken)
activate RT

RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH -> DB : findUnique(userId)
activate DB
DB --> AUTH : TàiKhoản + vaiTrò
deactivate DB
AUTH --> RT : req.user = {id, vaiTro}
deactivate AUTH

RT -> SV : create(dữ liệu đặt lịch)
activate SV

SV -> DB : Kiểm tra BácSĩ, BệnhNhân,\nLịchLàmViệc & Trùng lịch
activate DB
DB --> SV : Kết quả hợp lệ
deactivate DB

alt Hình thức = Offline (Tại quầy)
  SV -> DB : INSERT DatLich (trangThai=0, ttThanhToan=0)
  activate DB
  DB --> SV : Created
  deactivate DB
  SV --> RT : Dữ liệu lịch hẹn
  RT --> FE : 201 Created
  FE --> BN : Thông báo thành công

else Hình thức = Online (VNPay)
  SV -> DB : INSERT DatLich (trangThai=0, ttThanhToan=0)
  activate DB
  DB --> SV : Created
  deactivate DB
  
  SV -> SV : createTransactionData()
  SV -> PAY : createPaymentUrl(amount, refId)
  activate PAY
  PAY --> SV : paymentUrl (vnpay.vn/...)
  deactivate PAY
  
  SV -> DB : INSERT GiaoDich (trangThai=0: Chờ)
  activate DB
  DB --> SV : Created
  deactivate DB
  
  SV --> RT : {booking, paymentUrl}
  RT --> FE : 201 Created + paymentUrl
  FE -> BN : Redirect sang VNPay Gateway
end

deactivate SV
deactivate RT
deactivate FE
@enduml
