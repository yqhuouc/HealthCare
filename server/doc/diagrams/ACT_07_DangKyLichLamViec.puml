@startuml Activity_DangKyLichLamViec_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bác sĩ / Admin|
start
:Chọn ngày làm việc & khung giờ;
:Gửi yêu cầu tạo lịch làm việc;

|Hệ thống|
:Xác thực JWT & Kiểm tra quyền hạn;
:Validate dữ liệu (lichLamViecSchema);

if (Dữ liệu hợp lệ?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Kiểm tra thực thể (Bác sĩ/Khung giờ);
  :Kiểm tra trùng lịch (Check existing);
  
  if (Bị trùng lịch?) then (Có)
    :Trả về mã 409 (Conflict);
    stop
  else (Không)
    :Tạo bản ghi LichLamViecBacSi;
    :Trả về mã 201 (Created);
  endif
endif

|Bác sĩ / Admin|
:Cập nhật giao diện lịch hiển thị;
stop
@enduml