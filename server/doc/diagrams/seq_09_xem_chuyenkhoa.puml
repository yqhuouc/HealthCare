@startuml Seq_XemChuyenKhoa
skinparam sequenceArrowThickness 2
actor "Người dùng" as User
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "ChuyenKhoa\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

User -> FE : Mở trang chuyên khoa
activate FE
FE -> RT : GET /api/chuyen-khoa
activate RT
RT -> SV : getAll()
activate SV
SV -> DB : findMany()\n+ include _count.bacSi
activate DB
DB --> SV : Danh sách chuyên khoa
deactivate DB
SV --> RT : Dữ liệu chuyên khoa
deactivate SV
RT --> FE : 200 OK {chuyên khoa}
deactivate RT
FE --> User : Hiển thị danh sách\nchuyên khoa
deactivate FE
@enduml
