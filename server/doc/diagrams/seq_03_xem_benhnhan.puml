@startuml Seq_XemThongTinBenhNhan
skinparam sequenceArrowThickness 2
actor "Admin" as AD
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "BenhNhan\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

AD -> FE : Xem thông tin\nbệnh nhân
activate FE
FE -> RT : GET /api/benh-nhan/:id\n(Bearer token)
activate RT
RT -> AUTH : authenticate(JWT)
activate AUTH
AUTH --> RT : req.user (Admin)
deactivate AUTH
RT -> SV : getById(id)
activate SV
SV -> DB : findUnique({id})\n+ include taiKhoan
activate DB
DB --> SV : Dữ liệu bệnh nhân
deactivate DB
SV --> RT : Thông tin bệnh nhân
deactivate SV
RT --> FE : 200 OK {bệnh nhân}
deactivate RT
FE --> AD : Hiển thị chi tiết\nbệnh nhân
deactivate FE
@enduml
