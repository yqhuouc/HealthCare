@startuml UC_QuanLyLichKham
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

actor "Bệnh nhân" as BN #LightBlue
actor "Bác sĩ" as BS #LightGreen
actor "Quản trị viên" as AD #LightCoral

rectangle "Chức năng quản lý lịch khám" {
  usecase "Xem tất cả\nlịch khám" as UC1
  usecase "Xem chi tiết\nlịch khám" as UC2
  usecase "Đặt lịch khám\nmới" as UC3
  usecase "Cập nhật trạng thái\nlịch khám" as UC4
  usecase "Hủy lịch khám" as UC5
  usecase "Xóa lịch khám" as UC6

  usecase "Xác thực JWT" as INC1 #LightGray
  usecase "Kiểm tra lịch\nlàm việc bác sĩ" as INC2 #LightGray
  usecase "Kiểm tra\ntrùng lịch" as INC3 #LightGray
  usecase "Kiểm tra quyền\nsở hữu" as INC4 #LightGray
  usecase "Chọn hình thức\nthanh toán" as EXT1 #LightGray
}

BN "1" -- "0..*" UC3
BN "1" -- "0..*" UC5
BS "1" -- "0..*" UC4
AD "1" -- "0..*" UC1
AD "1" -- "0..*" UC4
AD "1" -- "0..*" UC6

UC3 ..> INC1 : <<include>>
UC3 ..> INC2 : <<include>>
UC3 ..> INC3 : <<include>>
EXT1 ..> UC3 : <<extend>>
UC4 ..> INC1 : <<include>>
UC4 ..> INC4 : <<include>>
UC5 ..> INC1 : <<include>>
UC5 ..> INC4 : <<include>>
UC6 ..> INC1 : <<include>>
@enduml
