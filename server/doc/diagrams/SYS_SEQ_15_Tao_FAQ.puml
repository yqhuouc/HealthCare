@startuml SYS_SEQ_15_Tao_FAQ
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_15_Tao_FAQ

actor "Quản trị viên" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Gửi nội dung FAQ mới
activate Sys

Sys -> DB : 1.1: Lưu FAQ vào CSDL
activate DB
DB --> Sys : 1.2: Trả về kết quả
deactivate DB

alt Hợp lệ
    Sys --> User : 1.3: Thông báo thêm thành công
else Thiếu thông tin
    Sys --> User : 1.4: Hiển thị lỗi validate
end

deactivate Sys

@enduml
