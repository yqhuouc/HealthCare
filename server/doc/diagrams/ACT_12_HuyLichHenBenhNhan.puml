@startuml Activity_HuyLichHenBenhNhan_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bệnh nhân|
start
:Mở lịch sử đặt lịch;
:Chọn lịch hẹn cần hủy;
:Bấm nút "Hủy lịch hẹn";

|Hệ thống|
:Xác thực JWT & Kiểm tra quyền sở hữu;
:Kiểm tra điều kiện hủy\n(Thời gian tối thiểu/Trạng thái);

if (Đủ điều kiện hủy?) then (Không)
  :Trả về mã 400 (Bad Request);
  stop
else (Có)
  :Cập nhật trạng thái lịch = "Đã hủy";
  
  if (Đã thanh toán Online?) then (Có)
    :Chuyển xử lý hoàn tiền (Refund Process);
    :Ghi nhận lịch sử giao dịch hoàn tiền;
  else (Không)
  endif

  :Giải phóng khung giờ làm việc của Bác sĩ;
  :Trả về kết quả hủy thành công;
endif

|Bệnh nhân|
:Hiển thị thông báo "Hủy thành công";
:Làm mới danh sách lịch hẹn;
stop
@enduml