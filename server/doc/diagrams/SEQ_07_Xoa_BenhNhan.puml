@startuml Seq_XoaTaiKhoanBenhNhan
skinparam sequenceArrowThickness 2
actor "Admin" as AD
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "Auth\nMiddleware" as AUTH #Orange
participant "BenhNhan\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

AD -> FE : Bấm xóa tài khoản\nbệnh nhân
activate FE
FE -> RT : DELETE /api/benh-nhan/:id\n(Bearer token)
activate RT
RT -> AUTH : authenticate(JWT)\n+ authorize("admin")
activate AUTH
AUTH --> RT : req.user (Admin)
deactivate AUTH
RT -> SV : delete(id)
activate SV
SV -> DB : findUnique({id})
activate DB
DB --> SV : Bệnh nhân
deactivate DB

alt Tồn tại
  SV -> DB : DELETE BenhNhan\nWHERE id
  activate DB
  DB --> SV : OK
  deactivate DB
  SV -> DB : DELETE TaiKhoan\nWHERE id = taiKhoanId
  activate DB
  DB --> SV : OK
  deactivate DB
  SV --> RT : Xóa thành công
  RT --> FE : 200 OK
  FE --> AD : Hiển thị\nxóa thành công
else Không tìm thấy
  SV --> RT : Lỗi 404
  RT --> FE : 404
  FE --> AD : Hiển thị lỗi
end
deactivate SV
deactivate RT
deactivate FE
@enduml
