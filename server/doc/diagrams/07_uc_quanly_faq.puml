@startuml UC_QuanLyFAQ
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

actor "Quản trị viên" as AD #LightCoral
actor "Bệnh nhân" as BN #LightBlue

rectangle "Chức năng quản lý câu hỏi thường gặp" {
  usecase "Xem danh sách\ncâu hỏi thường gặp" as UC1
  usecase "Thêm câu hỏi\nmới" as UC2
  usecase "Sửa câu hỏi" as UC3
  usecase "Xóa câu hỏi" as UC4

  usecase "Xác thực JWT" as INC1 #LightGray
  usecase "Kiểm tra quyền\nAdmin" as INC2 #LightGray
}

BN -- UC1
AD "1" -- "0..*" UC2
AD "1" -- "0..*" UC3
AD "1" -- "0..*" UC4

UC2 ..> INC1 : <<include>>
UC2 ..> INC2 : <<include>>
UC3 ..> INC1 : <<include>>
UC3 ..> INC2 : <<include>>
UC4 ..> INC1 : <<include>>
UC4 ..> INC2 : <<include>>
@enduml
