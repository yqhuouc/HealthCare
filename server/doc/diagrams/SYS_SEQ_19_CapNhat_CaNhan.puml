@startuml SYS_SEQ_19_CapNhat_CaNhan
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_19_CapNhat_CaNhan

actor "Người dùng" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Gửi thay đổi hồ sơ
activate Sys

Sys -> DB : 1.1: Cập nhật dữ liệu TaiKhoan
activate DB
DB --> Sys : 1.2: Trả về kết quả sửa
deactivate DB

alt Hợp lệ
    Sys --> User : 1.3: Thông báo cập nhật thành công
else Lỗi thông tin
    Sys --> User : 1.4: Hiển thị thông báo từ chối
end

deactivate Sys

@enduml
