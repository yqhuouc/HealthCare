@startuml Seq_XemFAQ
skinparam sequenceArrowThickness 2
actor "Người dùng" as User
participant "Giao diện" as FE #LightBlue
participant "Router" as RT #LightYellow
participant "FAQ\nService" as SV #LightGreen
database "CSDL" as DB #LightCoral

User -> FE : Mở trang câu hỏi\nthường gặp
activate FE
FE -> RT : GET /api/cau-hoi-thuong-gap
activate RT
RT -> SV : getAll()
activate SV
SV -> DB : findMany\n({dangHoatDong: 1})
activate DB
DB --> SV : Danh sách FAQ
deactivate DB
SV --> RT : Dữ liệu FAQ
deactivate SV
RT --> FE : 200 OK {FAQ}
deactivate RT
FE --> User : Hiển thị danh sách\ncâu hỏi - trả lời
deactivate FE
@enduml
