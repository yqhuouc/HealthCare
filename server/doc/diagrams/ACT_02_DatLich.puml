@startuml Activity_DatLich

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  RoundCorner 15
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Benh nhan|
start
:Xem danh sach chuyen khoa;
:Chon chuyen khoa;
:Xem danh sach bac si theo chuyen khoa;
:Chon bac si;
:Xem thong tin chi tiet bac si va lich trong;
:Chon ngay va khung gio;
:Nhap ly do kham;
:Chon hinh thuc thanh toan;
:Gui yeu cau dat lich (kem JWT token);

|He thong|
:Xac thuc JWT va validate du lieu;
:Kiem tra bac si, benh nhan va lich lam viec;
:Kiem tra trung lich (unique constraint);

if (Hinh thuc thanh toan?) then (Offline)
  :Tao DatLich (trangThai=0, trangThaiThanhToan=0);
  :Tra ve 201 Created;
  |Benh nhan|
  :Nhan ket qua dat lich;
  :Hien thi Dat lich thanh cong;
  stop
else (VNPay)
  |He thong|
  :Tao DatLich (trangThai=0, trangThaiThanhToan=0);
  :Tao GiaoDich (trangThai=0: Cho);
  :Goi POST /api/vnpay/create-payment;
  :Tao URL thanh toan VNPay;
  :Tra ve URL VNPay cho Frontend;
  |Benh nhan|
  :Nhan URL thanh toan;
  :Chuyen huong sang VNPay Gateway;
  :Nguoi dung thuc hien thanh toan;
  :VNPay redirect ve /payment/result;
  :Frontend goi POST /api/vnpay/verify\nde xac thuc va dong bo DB;
  if (Thanh toan thanh cong?) then (Co)
    :Hien thi Thanh toan thanh cong;
  else (Khong)
    :Hien thi Giao dich that bai;
  endif
  stop
endif
@enduml
