@startuml Activity_DatLich_Full_V3

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bệnh nhân / Frontend|
start
:Chọn chuyên khoa & Bác sĩ;
:Chọn ngày giờ & Nhập lý do;
:Chọn hình thức thanh toán;
:Gửi yêu cầu đặt lịch (JWT);

|Máy chủ / Backend|
:Xác thực JWT & Validate dữ liệu;
:Kiểm tra thực thể & Lịch làm việc;
:Kiểm tra trùng lịch (Unique constraint);

if (Hình thức thanh toán?) then (Tại quầy)
  :Tạo Đặt Lịch\n(trangThai=0, ttThanhToan=0);
  :Trả về mã 201 Created;
  
  |Bệnh nhân / Frontend|
  :Hiển thị "Đặt lịch thành công";
  stop

else (VNPay)
  |Máy chủ / Backend|
  :Tạo Đặt Lịch (trangThai=0, ttThanhToan=0);
  :Tạo Giao Dịch (trangThai=0: Chờ);
  :Gọi dịch vụ VNPay tạo URL thanh toán;
  :Trả về URL VNPay cho Frontend;

  |Bệnh nhân / Frontend|
  :Chuyển hướng sang VNPay Gateway;
  :Người dùng thực hiện thanh toán;
  :VNPay redirect về /payment/result;
  :Frontend gọi API /verify để đồng bộ;

  |Máy chủ / Backend|
  :Xác thực chữ ký & Kiểm tra kết quả;
  :Cập nhật trạng thái Đặt lịch/Giao dịch;
  :Trả kết quả xác thực;

  |Bệnh nhân / Frontend|
  if (Thanh toán thành công?) then (Có)
    :Hiển thị "Thanh toán thành công";
  else (Không)
    :Hiển thị "Giao dịch thất bại";
  endif
  stop
endif

@enduml