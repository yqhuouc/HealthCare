@startuml UC_QuanLyCaLamViec
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor LightYellow
  BorderColor DarkSlateGray
}

actor "Bác sĩ" as BS #LightGreen
actor "Quản trị viên" as AD #LightCoral

rectangle "Chức năng quản lý ca làm việc" {
  usecase "Xem danh sách\nca làm việc" as UC1
  usecase "Tạo ca làm việc\nmới" as UC2
  usecase "Cập nhật\nca làm việc" as UC3
  usecase "Xóa ca làm việc" as UC4
  usecase "Duyệt đăng ký\nca làm việc" as UC5

  usecase "Xác thực JWT" as INC1 #LightGray
  usecase "Kiểm tra lịch\nkhông bị trùng" as INC2 #LightGray
  usecase "Kiểm tra quyền\nBác sĩ" as INC3 #LightGray
}

BS "1" -- "0..*" UC1
BS "1" -- "0..*" UC2
BS "1" -- "0..*" UC3
BS "1" -- "0..*" UC4
AD "1" -- "0..*" UC5

UC2 ..> INC1 : <<include>>
UC2 ..> INC2 : <<include>>
UC2 ..> INC3 : <<include>>
UC3 ..> INC1 : <<include>>
UC4 ..> INC1 : <<include>>
UC5 ..> INC1 : <<include>>
@enduml
