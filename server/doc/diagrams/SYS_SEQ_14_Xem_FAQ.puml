@startuml SYS_SEQ_14_Xem_FAQ
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_14_Xem_FAQ

actor "Người dùng" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Yêu cầu đọc câu hỏi thường gặp
activate Sys

Sys -> DB : 1.1: Truy vấn danh sách FAQ
activate DB
DB --> Sys : 1.2: Trả về dữ liệu FAQ
deactivate DB

alt Thành công
    Sys --> User : 1.3: Hiển thị nội dung
else Khôn có dữ liệu
    Sys --> User : 1.4: Hiển thị thông báo lỗi
end

deactivate Sys

@enduml
