@startuml UseCase_HoSoCaNhan
left to right direction
skinparam actorStyle awesome
skinparam ranksep 100
skinparam nodesep 50

skinparam usecase {
  BackgroundColor LightSkyBlue
  BorderColor DarkSlateGray
  FontSize 12
}

' ============================
' ACTORS
' ============================
actor "Bệnh nhân" as BN #SkyBlue
actor "Bác sĩ" as BS #LightGreen
actor "Quản trị viên" as AD #LightCoral

' ============================
' CHỨC NĂNG NGHIỆP VỤ
' ============================
(Cập nhật thông tin cá nhân) as UC1
(Đổi mật khẩu) as UC2

' ============================
' KẾT NỐI
' ============================
BN --- UC1
BN --- UC2

BS --- UC1
BS --- UC2

AD --- UC1
AD --- UC2

' Sắp xếp dọc
BN -[hidden]down- BS
BS -[hidden]down- AD

@enduml
