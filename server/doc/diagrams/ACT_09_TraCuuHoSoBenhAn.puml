@startuml Activity_TraCuuHoSoBenhAn_V2

skinparam shadowing false
skinparam backgroundColor white
skinparam conditionStyle diamond
skinparam ConditionEndStyle hline

skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1E88E5
  FontColor #0D47A1
  FontSize 13
  RoundCorner 20
}

skinparam activityDiamondBackgroundColor #BBDEFB
skinparam activityDiamondBorderColor #1E88E5
skinparam activityDiamondFontColor #0D47A1
skinparam ArrowColor #1E88E5

|Bác sĩ / Admin|
start
:Mở màn hình tra cứu hồ sơ;
:Nhập mã bệnh nhân hoặc tên;
:Gửi yêu cầu tra cứu;

|Hệ thống|
:Xác thực JWT & Kiểm tra quyền hạn;
:Truy vấn danh sách Đặt lịch (Medical History);
:Truy vấn Đơn thuốc & Kết quả chẩn đoán;

if (Tìm thấy dữ liệu hồ sơ?) then (Không)
  :Trả về kết quả rỗng (Mã 200 - Empty);
  |Bác sĩ / Admin|
  :Thông báo: "Không có dữ liệu lịch sử";
  stop
else (Có)
  |Hệ thống|
  :Tổng hợp dữ liệu hồ sơ bệnh án;
  :Trả về danh sách hồ sơ chi tiết;
endif

|Bác sĩ / Admin|
:Hiển thị lịch sử khám, chẩn đoán\nvà danh mục đơn thuốc;
stop
@enduml