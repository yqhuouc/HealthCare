@startuml SYS_SEQ_08_Tao_LichLamViec
skinparam sequenceArrowThickness 1.5

mainframe sd SYS_SEQ_08_Tao_LichLamViec

actor "Bác sĩ / Quản trị" as User
participant "Hệ thống" as Sys #SkyBlue
participant "Cơ sở dữ liệu" as DB #SkyBlue

User -> Sys : 1: Gửi dữ liệu tạo lịch làm việc
activate Sys

Sys -> DB : 1.1: Lưu lịch mới vào CSDL
activate DB
DB --> Sys : 1.2: Trả về trạng thái lưu
deactivate DB

alt Không trùng lịch
    Sys --> User : 1.3: Thông báo tạo thành công
else Lỗi trùng lặp
    Sys --> User : 1.4: Hiển thị lỗi trùng lịch
end

deactivate Sys

@enduml
